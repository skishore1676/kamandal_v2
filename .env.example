# Google Sheets configuration cockpit.
# Share the sheet with the service-account client_email as Editor.
KAMANDAL_SHEET_ID=16Vjgrj80VDeTIGg0y60w4LHenZg7R-tGGvOyLNFdFsE
GOOGLE_API_CREDENTIALS_PATH=../public_api_trading_v3/config/google-credentials.json

# Runtime control. Keep these out of the Google Sheet for now.
KAMANDAL_MODE=shadow
KAMANDAL_TRADING_ENABLED=false
KAMANDAL_HALT=false
KAMANDAL_APPROVAL_MODE=shadow_auto_top_plan

# Live exit pipeline rollout. Keep `sheet` until the ledger drain is explicitly
# observed during a live cutover window.
KAMANDAL_LIVE_EXIT_SUBMIT_SOURCE=sheet
KAMANDAL_LIVE_MAX_CLOSE_SUBMITS_PER_RUN=10
KAMANDAL_LIVE_EXIT_REPRICE_ENABLED=true
KAMANDAL_LIVE_EXIT_REPRICE_AFTER_MINUTES=10
KAMANDAL_LIVE_EXIT_REPRICE_MAX_REPRICES=2
KAMANDAL_LIVE_EXIT_REPRICE_EXPIRE_AFTER_MINUTES=390
KAMANDAL_LIVE_HEALTH_EXIT_PIPELINE_STALLED_MINUTES=20

# Risk manager circuit breakers (blocks NEW live entries only; exits always allowed).
# Master switch — leave false until the knobs below are reviewed. Defaults live in
# config/control.yaml under risk_manager:; env values override per knob.
KAMANDAL_RISK_MANAGER_ENABLED=false
KAMANDAL_RISK_MAX_ACCOUNT_SNAPSHOT_AGE_MINUTES=180
KAMANDAL_RISK_MAX_DAILY_DRAWDOWN_PCT=4.0
KAMANDAL_RISK_MAX_WEEKLY_DRAWDOWN_PCT=7.0
KAMANDAL_RISK_CONSECUTIVE_LOSS_LIMIT=4
KAMANDAL_RISK_COOLDOWN_DAYS=2
KAMANDAL_RISK_MAX_NEW_POSITIONS_PER_DAY=4
KAMANDAL_RISK_MAX_POSITIONS_PER_CLUSTER=3
# Correlation clusters (symbol lists) are configured in config/control.yaml risk_manager.correlation_clusters.

# Vertical spread width search (planner.vertical_width_search in control.yaml).
# Off by default; flip to true after a shadow day to let the put/call spread
# builders try wider longs when the default width fails the credit gate.
KAMANDAL_PLANNER_WIDTH_SEARCH_ENABLED=false
KAMANDAL_PLANNER_WIDTH_SEARCH_WIDTHS=5.0,7.5,10.0

# Scheduler/runtime paths. YouTube IDs can also live one per line in data/youtube_queue.txt.
KAMANDAL_MARKET_TZ=America/Chicago
KAMANDAL_ACTIVE_IDEAS_DIR=data/ideas/active
KAMANDAL_YOUTUBE_VIDEO_IDS=
KAMANDAL_YOUTUBE_QUEUE_FILE=data/youtube_queue.txt
KAMANDAL_YOUTUBE_CHANNEL_IDS=UCLJiSMXJ9K-1AOTqIqdXJgQ
KAMANDAL_YOUTUBE_CHANNEL_LIMIT=1
KAMANDAL_YOUTUBE_CHANNEL_FILE=config/youtube_channels.txt
KAMANDAL_YOUTUBE_INCLUDE_KEYWORDS=
KAMANDAL_YOUTUBE_EXCLUDE_KEYWORDS=
KAMANDAL_YOUTUBE_LANGUAGES=en
KAMANDAL_YOUTUBE_TRANSCRIPT_PROVIDER=yt_dlp
KAMANDAL_YTDLP_SLEEP_REQUESTS=3
KAMANDAL_YTDLP_SLEEP_SUBTITLES=5
KAMANDAL_YTDLP_ARCHIVE_FILE=data/youtube_archive.txt
KAMANDAL_YTDLP_COOKIES_FROM_BROWSER=
KAMANDAL_MARKET_PROVIDER=public

# Broker access. Keep the token local; do not commit .env.
KAMANDAL_BROKER=tastytrade
PUBLIC_SECRET_TOKEN=
PUBLIC_API_BASE_URL=https://api.public.com
PUBLIC_AUTH_ENDPOINT=https://api.public.com/userapiauthservice/personal/access-tokens
PUBLIC_ACCOUNT_ID=
PUBLIC_SESSION_FILE=config/public_session.json
PUBLIC_ACCOUNT_CACHE_FILE=config/public_account.json
API_REQUESTS_PER_SECOND=5.0
API_BURST_LIMIT=5

# tastytrade OAuth. Generate these in tastytrade Manage > My profile > API > OAuth Applications.
TASTYTRADE_API_BASE_URL=https://api.tastytrade.com
TASTYTRADE_CLIENT_ID=
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
TASTYTRADE_ACCOUNT_NUMBER=
TASTYTRADE_API_VERSION=
TASTYTRADE_OAUTH_SCOPES=read,trade
TASTYTRADE_SESSION_FILE=config/tastytrade_session.json
TASTYTRADE_ACCOUNT_CACHE_FILE=config/tastytrade_account.json

# LLM. Default is local Codex CLI; other providers can be wired later.
KAMANDAL_LLM_PROVIDER=codex_cli
KAMANDAL_LLM_MODEL=
KAMANDAL_CODEX_BINARY=
KAMANDAL_CODEX_WORKDIR=
KAMANDAL_CODEX_TIMEOUT_SECONDS=300
