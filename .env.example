# Google Sheets configuration cockpit.
# Share the sheet with the service-account client_email as Editor.
KAMANDAL_SHEET_ID=16Vjgrj80VDeTIGg0y60w4LHenZg7R-tGGvOyLNFdFsE
GOOGLE_API_CREDENTIALS_PATH=../public_api_trading_v3/config/google-credentials.json

# Runtime control. Keep these out of the Google Sheet for now.
KAMANDAL_MODE=shadow
KAMANDAL_TRADING_ENABLED=false
KAMANDAL_HALT=false
KAMANDAL_APPROVAL_MODE=shadow_auto_top_plan

# Scheduler/runtime paths. YouTube IDs can also live one per line in data/youtube_queue.txt.
KAMANDAL_MARKET_TZ=America/Chicago
KAMANDAL_ACTIVE_IDEAS_DIR=data/ideas/active
KAMANDAL_YOUTUBE_VIDEO_IDS=
KAMANDAL_YOUTUBE_QUEUE_FILE=data/youtube_queue.txt
KAMANDAL_YOUTUBE_CHANNEL_IDS=UCLJiSMXJ9K-1AOTqIqdXJgQ
KAMANDAL_YOUTUBE_CHANNEL_LIMIT=1
KAMANDAL_YOUTUBE_CHANNEL_FILE=config/youtube_channels.txt
KAMANDAL_YOUTUBE_INCLUDE_KEYWORDS=
KAMANDAL_YOUTUBE_EXCLUDE_KEYWORDS=
KAMANDAL_YOUTUBE_LANGUAGES=en
KAMANDAL_MARKET_PROVIDER=public

# Broker access. Keep the token local; do not commit .env.
PUBLIC_SECRET_TOKEN=
PUBLIC_API_BASE_URL=https://api.public.com
PUBLIC_AUTH_ENDPOINT=https://api.public.com/userapiauthservice/personal/access-tokens
PUBLIC_ACCOUNT_ID=
PUBLIC_SESSION_FILE=config/public_session.json
PUBLIC_ACCOUNT_CACHE_FILE=config/public_account.json
API_REQUESTS_PER_SECOND=5.0
API_BURST_LIMIT=5

# LLM. Default is local Codex CLI; other providers can be wired later.
KAMANDAL_LLM_PROVIDER=codex_cli
KAMANDAL_LLM_MODEL=
KAMANDAL_CODEX_BINARY=
KAMANDAL_CODEX_WORKDIR=
KAMANDAL_CODEX_TIMEOUT_SECONDS=300
